[sub_resource type="GDScript" id="GDScript_muk3w"]
script/source = "extends LineEdit




	
@onready var httprequest = $\"../../SearchData\"

var headers = [
		\"Authorization: Bot MTQzMjMyMzI0OTQzNzQwOTMzMA.GV0E3Z._-C96YA3f2kVkw6vXGUXdw2bTdbPG4yI-DV0Co\",
		 \"Content-Type: application/json\"
]

func _on_button_pressed() -> void:
	if self.text == \"\":
		OS.alert(\"O campo de ID não pode estar vazio.\", \"Ei, não se esqueça de mim!\")
	else:
		var idinput = self.text
		var url = \"https://discord.com/api/v10/users/%s\" % int(idinput)
		httprequest.request(url, headers)

func _on_discord_requests_request_completed(_result: int, _response_code: int, _headers: PackedStringArray, _body: PackedByteArray) -> void:
	var outputrequest = _body.get_string_from_utf8()
	
	var json = JSON.new()
	
	var info = json.parse(outputrequest)
	if info == OK:
		var data = json.get_data()
		var avatar = data.get(\"avatar\", \"\")
		var banner = data.get(\"banner\", \"\")
		print(avatar)
		print(banner)
"

